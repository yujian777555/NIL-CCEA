{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIL-CCEA episode record",
  "type": "object",
  "required": ["run_id", "mode", "task_id", "task_version", "task_family", "seed", "configuration_id", "configuration", "config_hash", "source_commit", "status", "trajectory", "failures", "retry_count", "manifest"],
  "properties": {
    "run_id": {"type": "string"},
    "mode": {"type": "string"},
    "task_id": {"type": "string"},
    "task_version": {"type": "string"},
    "task_family": {"type": "string"},
    "seed": {"type": "integer"},
    "repeat_index": {"type": "integer", "minimum": 0},
    "primary_endpoint": {"type": "string"},
    "evaluation_type": {"type": "string"},
    "configuration_id": {"type": "string"},
    "configuration": {"type": "object", "minProperties": 4},
    "config_hash": {"type": "string"},
    "source_commit": {"type": "string"},
    "status": {"enum": ["success", "agent_failed", "infra_failed"]},
    "failure_kind": {"type": ["string", "null"]},
    "primary_score": {"type": ["number", "null"]},
    "trajectory": {"type": "array"},
    "failures": {"type": "array"},
    "retry_count": {"type": "integer", "minimum": 0},
    "usage": {"type": "object"},
    "manifest": {"type": "object"}
  },
  "additionalProperties": true
}
